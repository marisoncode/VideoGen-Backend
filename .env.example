# AI LLM Script Generation (Groq - Llama 3.3 70B & OpenAI GPT-OSS 120B)
GROQ_API_KEY=

# Cloudflare Workers AI FLUX (Free High-Quality 16:9 Image Generation, 10,000 free Neurons/day)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Replicate API (Optional secondary image generation & LTX-Video animation fallback)
REPLICATE_API_TOKEN=

# Default Audio Voice (Free Microsoft Edge Neural Voices)
# Options: en-US-AvaMultilingualNeural, en-US-JennyNeural, en-US-GuyNeural, en-IN-NeerjaNeural
DEFAULT_VOICE=en-US-AvaMultilingualNeural

# Output Resolution: 1080p (1920x1080) or 720p (1280x720)
OUTPUT_WIDTH=1920
OUTPUT_HEIGHT=1080
OUTPUT_FPS=30

# Directories
STORAGE_DIR=storage
OUTPUT_DIR=outputs
TEMP_DIR=temp
