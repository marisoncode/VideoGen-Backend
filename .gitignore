# ==============================================================================
# Backend Git Ignore
# ==============================================================================

# Environment variables & API credentials (NEVER commit secrets)
.env
.env.*
*.env
!.env.example

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# Application generated storage, user uploads & temporary renders
storage/
storage/uploads/*
!storage/uploads/.gitkeep
storage/outputs/*
!storage/outputs/.gitkeep
storage/visual_cache/
storage/project_input.json
temp/
*.tmp

# Media and log outputs
*.mp4
*.mp3
!app/assets/music/*.mp3
*.wav
*.srt
*.log

# OS and Editor files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.vscode/
.idea/
*.swp
*.swo
